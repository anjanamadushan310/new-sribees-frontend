# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment files. Vite inlines every VITE_* value into the client
# bundle, so nothing secret belongs here either way — but an untracked .env is
# what stops a real key from being committed the day someone adds one.
# Copy .env.example instead.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright: browsers live in the shared ms-playwright cache, but reports and
# traces are per-run artefacts.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
